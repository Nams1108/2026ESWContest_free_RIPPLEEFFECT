// ============================================================
// I2S TX BUFFER
// ============================================================
static const uint32_t CHUNK_FRAMES = 1024;
static int16_t stereoBuffer[CHUNK_FRAMES * 2];

static void writeStereoFrames(uint32_t frames)
{
  const size_t bytes = frames * 2 * sizeof(int16_t);
  size_t written = I2S.write((uint8_t *)stereoBuffer, bytes);

  if (written != bytes)
  {
    Serial.print("I2S short write: ");
    Serial.print(written);
    Serial.print(" / ");
    Serial.println(bytes);
  }
}

// ============================================================
// PLAY PERIODIC TABLE
// ============================================================
static void playPeriodicTable(
  const int16_t *table,
  uint32_t periodFrames,
  uint32_t totalFrames
)
{
  uint32_t sent = 0;
  uint32_t tablePos = 0;

  while (sent < totalFrames)
  {
    uint32_t remain = totalFrames - sent;
    uint32_t n = (remain > CHUNK_FRAMES) ? CHUNK_FRAMES : remain;

    for (uint32_t i = 0; i < n; i++)
    {
      int16_t s = table[tablePos] >> 1;

      stereoBuffer[i * 2]     = s;
      stereoBuffer[i * 2 + 1] = s;

      tablePos++;
      if (tablePos >= periodFrames)
        tablePos = 0;
    }

    writeStereoFrames(n);
    sent += n;
  }
}

static void playSilence(uint32_t totalFrames)
{
  memset(stereoBuffer, 0, sizeof(stereoBuffer));

  uint32_t sent = 0;

  while (sent < totalFrames)
  {
    uint32_t remain = totalFrames - sent;
    uint32_t n = (remain > CHUNK_FRAMES) ? CHUNK_FRAMES : remain;

    writeStereoFrames(n);
    sent += n;
  }
}

// ============================================================
// BEACON
// ============================================================
static void playX()
{
  playPeriodicTable(X_TABLE, 480, TONE_FRAMES);
}

static void playY()
{
  playPeriodicTable(Y_TABLE, 960, TONE_FRAMES);
}

static void playPacket()
{
  playX();
  playSilence(GUARD_FRAMES);

  playY();
  playSilence(GUARD_FRAMES);

  playX();
  playSilence(GUARD_FRAMES);

  playY();
  playSilence(GUARD_FRAMES);
}

// ============================================================
// SETUP
// ============================================================
void setup()
{
  Serial.begin(115200);

  I2S.setPins(
    PIN_BCLK,
    PIN_LRCK,
    PIN_DOUT,
    -1,
    -1
  );

  bool ok = I2S.begin(
    I2S_MODE_STD,
    SAMPLE_RATE,
    I2S_DATA_BIT_WIDTH_16BIT,
    I2S_SLOT_MODE_STEREO
  );

  if (!ok)
  {
    Serial.println("I2S begin FAILED");
    while (1) delay(1000);
  }

  Serial.println("I2S begin PASS");
  Serial.println("No startup sine calculation");
  Serial.println("X = 500 + 900 Hz");
  Serial.println("Y = 650 + 1050 Hz");

  // PCM5102A settle time only
  playSilence(STARTUP_SILENCE_FRAMES);
}

// ============================================================
// LOOP
// ============================================================
void loop()
{
  playPacket();
  playSilence(PACKET_GAP_FRAMES);
}